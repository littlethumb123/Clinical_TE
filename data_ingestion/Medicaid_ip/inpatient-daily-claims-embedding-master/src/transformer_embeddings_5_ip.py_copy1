class pttr_state_singleton(object):
    _shared_borg_state = {}

    def __new__(cls, *args, **kwargs):
        obj = super(pttr_state_singleton, cls).__new__(cls, *args, **kwargs)
        obj.__dict__ = cls._shared_borg_state
        return obj


class pttr_state(pttr_state_singleton):
    pass

