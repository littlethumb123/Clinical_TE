MASK0 = 0b0000000000000000
MASK1 = 0b0000000000000001
MASK2 = 0b0000000000000010
MASK3 = 0b0000000000000100
MASK4 = 0b0000000000001000
MASK5 = 0b0000000000010000
MASK6 = 0b0000000000100000
MASK7 = 0b0000000001000000
MASK8 = 0b0000000010000000
MASK9 = 0b0000000100000000
MASKA = 0b0000001000000000
MASKB = 0b0000010000000000
MASKC = 0b0000100000000000
MASKD = 0b0001000000000000
MASKE = 0b0010000000000000
MASKF = 0b0100000000000000
MASKG = 0b1000000000000000
SAVE_DT_CNT_LIST = MASK1






class TransformerModel(nn.Module):
    def __init__(self, device, nhead, nhid, nlayers, dropout=0.05):
        super(TransformerModel, self).__init__()
        self.PTTR_STATE = pttr_state()
        self.device = device
        self.embedding_cd = nn.Embedding(self.PTTR_STATE.cd_cnt,self.PTTR_STATE.embedding_size)
        self.embedding_cd.weight.requires_grad = True
        self.embedding_gender_cd = nn.Embedding(4,self.PTTR_STATE.embedding_size)
        self.embedding_gender_cd.weight.requires_grad = True
        self.embedding_age_in_months = nn.Embedding(1440,self.PTTR_STATE.embedding_size)
        self.embedding_age_in_months.weight.requires_grad = True
        encoder_layers_cd = TransformerEncoderLayer(self.PTTR_STATE.embedding_size, 4, self.PTTR_STATE.embedding_size, 0)
        self.transformer_encoder_cd = TransformerEncoder(encoder_layers_cd, 1)
        encoder_layers_dy = TransformerEncoderLayer(self.PTTR_STATE.embedding_size, nhead, nhid, dropout)
        self.transformer_encoder_dy = TransformerEncoder(encoder_layers_dy, nlayers)

        self.mm = nn.GELU()
        self.decoder_cd = nn.Linear(self.PTTR_STATE.embedding_size, self.PTTR_STATE.target_cd_cnt)
        self.dropout = nn.Dropout(0.1)
        self.norm = nn.LayerNorm(self.PTTR_STATE.embedding_size)
        self.init_weights()

    def _generate_square_subsequent_mask(self, sz):
        mask = (torch.triu(torch.ones(sz, sz)) == 1).transpose(0, 1)
        mask = mask.float().masked_fill(mask == 0, float('-inf')).masked_fill(mask == 1, float(0.0))
        return mask

    def init_weights(self):
        initrange = 0.1
        nn.init.zeros_(self.decoder_cd.weight)
        nn.init.uniform_(self.decoder_cd.weight, -initrange, initrange)
    def forward(self, x):
        #device = torch.cuda.current_device()
        gpu_batchsize = x.shape[0]
        age_in_months = x[:,:,0]
        gender_cd = x[:,:,1]
        gender_cd = self.embedding_gender_cd(gender_cd)
        age_in_months = self.embedding_age_in_months(age_in_months)
        cd = x[:,:,2:]
        cd = self.embedding_cd(cd)
        cd_res = cd.sum(-2)
        # print(cd_res.shape)
        cd = cd.reshape(gpu_batchsize*self.PTTR_STATE.len_dy,self.PTTR_STATE.len_cd,self.PTTR_STATE.embedding_size)
        cd = torch.swapaxes(cd, 0, 1)
        cd = self.transformer_encoder_cd(cd)
        cd = cd.permute(1,2,0)
        cd = nn.MaxPool1d(self.PTTR_STATE.len_cd)(cd)
        cd = cd.reshape(gpu_batchsize,self.PTTR_STATE.len_dy,self.PTTR_STATE.embedding_size)
        # print(cd.shape)
        cd = cd_res+cd + gender_cd + age_in_months
        # print(cd.shape)
        cd = self.mm(cd)
        cd = self.norm(cd)
        cd = torch.swapaxes(cd, 0, 1)

        mth_mask = self._generate_square_subsequent_mask(self.PTTR_STATE.len_dy).to(self.device)
        cd = self.transformer_encoder_dy(cd, mth_mask)
        cd = torch.swapaxes(cd, 0, 1)
        cd = self.norm(cd)
        cd = self.dropout(cd)

        cd = self.decoder_cd(cd)
        cd = F.log_softmax(cd, dim=-1)

        return cd






