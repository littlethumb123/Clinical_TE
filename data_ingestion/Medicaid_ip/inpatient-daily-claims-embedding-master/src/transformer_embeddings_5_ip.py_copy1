def currentDateTag():
    newYorkTz = pytz.timezone("America/New_York")
    timeInNewYork = datetime.now(newYorkTz)
    currentDateInNewYork = timeInNewYork.strftime("%Y%m%d")
    return currentDateInNewYork

def currentTime():
    newYorkTz = pytz.timezone("America/New_York")
    timeInNewYork = datetime.now(newYorkTz)
    currentTimeInNewYork = timeInNewYork.strftime("%D %H:%M:%S")
    return currentTimeInNewYork

def conv_cd(ipt):
    ipt = ipt.split('*')
    ipt = ipt[:_PTTR_STATE.len_dy]
    ipt = ipt + (_PTTR_STATE.len_dy-len(ipt))*['']
    ipt = [dy.split(',') for dy in ipt]
    ipt = [[int(cd) if cd!='' else 0 for cd in dy] for dy in ipt]
    ipt = [dy + (_PTTR_STATE.len_cd-len(dy))*[0] for dy in ipt]
    return ipt

def conv_age_gender(ipt):
    ipt = ipt.split('*')
    ipt = ipt[:_PTTR_STATE.len_dy]
    try:
       ipt1 = [min(int(cd),1439) for cd in ipt]
    except Exception as e:
        pylogger.error(f'age error in {ipt}')
        traceback.print_exc()
        raise
    ipt1 = ipt1 + (_PTTR_STATE.len_dy-len(ipt))*[0]
    return ipt1

def conv_dy(x):
    x = x.split('*')
    x = x[:_PTTR_STATE.len_dy]
    x = [int(cd) for cd in x]
    return x

def prepare_tensor(batch, device):
    age_in_months = [conv_age_gender(ipt) for ipt in batch['age_in_months'].tolist()]
    age_in_months = torch.tensor(age_in_months).to(device)
    age_in_months = age_in_months.reshape(_PTTR_STATE.batch_size,_PTTR_STATE.len_dy,1)
    gender_cd = [conv_age_gender(ipt) for ipt in batch['gender_cd'].tolist()]
    gender_cd = torch.tensor(gender_cd).to(device)
    gender_cd = gender_cd.reshape(_PTTR_STATE.batch_size,_PTTR_STATE.len_dy,1)
    #cd = [conv_cd(ipt) for ipt in batch['cd'].tolist()] # This version may result in index out of range
    cd = [conv_cd(ipt) for ipt in batch['cd'].tolist()]
    cd = torch.tensor(cd).to(device)
    x = torch.cat([age_in_months,gender_cd,cd],dim=-1)
    #
    dt_cnt = batch['dt_cnt'].tolist()
    #
    return dt_cnt, x

#def score(data,filename,model,output_tbl,bq_client, bucket_name, envname, tenant, resource_sa, device_num):
def score(data, trunkid, ntrunks, model, output_tbl, bq_client, load_config, device_name):
    gpttr = model.PTTR_STATE
    result = 'ERROR'

    step = f'### Entering score(), trunkid={str(trunkid)}'
    try:
        step = f'### ... score(), trunkid={str(trunkid)} model.eval()'
        batch_size = gpttr.batch_size
        #device_name = f"cuda:{device_num}"
        #device = torch.device(device_name)
        device = model.device
        model.eval()
        activation = {}
        def get_activation(name):
            def hook(model, input, output):
                activation[name] = output.detach()
            return hook

        step = f'### ... score(), trunkid={str(trunkid)} model.transformer_encoder_dy.register_forward_hook'
        model.transformer_encoder_dy.register_forward_hook(get_activation('transformer_encoder_dy'))

        # dsize = data.shape[0]
        # nbatchfloor = int(np.floor(dsize/batch_size))
        # nbatch = int(np.ceil(dsize/batch_size))
        # rmod = dsize % batch_size
        #
        # pylogger.debug(f'### ... dsize: {str(dsize)}; nbatch: {str(nbatch)}; rmod: {str(rmod)}')
        #
        # #print('exec, calc dsize-nbatch*batch_size:', dsize-nbatch*batch_size, dsize, nbatch, batch_size)
        # step = f'### ... score(), trunkid={str(trunkid)} - appending data...'
        #
        # if (rmod > 0) :
        #     pylogger.debug(f'### ... dsize-nbatch*batch_size = {str(dsize-nbatchfloor*batch_size)}')
        #     k = batch_size - (dsize - nbatchfloor*batch_size) # fill some records to build last trunk; these will be deleted in the end
        #     data = pd.concat([data,data.head(k)], ignore_index=True)
        #     #print('1st appended')

        dsize = data.shape[0]
        nbatch = int(np.floor(dsize/batch_size))

        pylogger.debug(f'### ... dsize: {str(dsize)}; nbatch: {str(nbatch)}')
        #print('exec, calc dsize-nbatch*batch_size:', dsize-nbatch*batch_size, dsize, nbatch, batch_size)

        if dsize-nbatch*batch_size>0:
            k = batch_size - (dsize-nbatch*batch_size) # fill some records to build last trunk; these will be deleted in the end
            #data = pd.concat([data,data.head(k)])
            data = pd.concat([data, pd.concat([data.head(1)]* k,  ignore_index=True)])
            #pylogger.warn(f'### ......  {device_name}: trunk# {trunkid+1} of {ntrunks}, and we should not be executing this logic.' )
            #print('1st appended', k)

        # data = data.reset_index(drop=True)
        data.reset_index(drop=True, inplace=True)
        nbatch = int(data.shape[0]/batch_size)


        # # added in case data is less than batch size
        # if dsize < batch_size:
        #     k = batch_size - dsize # fill some records to build last trunk; these will be deleted in the end
        #     data = pd.concat([data, data.loc[data.head(1).index.repeat(k)]]).reset_index(drop=True)
        #     #print('2nd appended', k)

        step = f'### ... score(), trunkid={str(trunkid)} iterating over {str(nbatch)} batches and appending results'
        pylogger.debug(f'### ... 2nd dsize: {str(data.shape[0])}; 2nd nbatch: {str(nbatch)}; \n### ... step: {step}')

        ys = []
        saved_dtlists = []
        for j in range(nbatch):
            try:
                step = f'### ... score() main for loop, entering iter index j: {str(j)}'
                batch = data.iloc[j*batch_size:j*batch_size+batch_size,:]
                #print('batch:', batch.shape, i)

                dt_cnt, x = prepare_tensor(batch, device)
                #model = model(x)
                opts = model(x)
                #step = f'### ... score() main for loop, iter index j: {str(j)}; tensor prepared, start activation loop;\n'\
                #    + f'### ... ... dt_cnt list: {" ".join(map(str, dt_cnt))}'
                intermedia_output = activation['transformer_encoder_dy']
                intermedia_output = [intermedia_output[dt_cnt[i],i,:].reshape(1,-1) for i in range(batch_size)]
                intermedia_output = torch.cat(intermedia_output)
                #print('intermedia_output:', intermedia_output.shape, i)
                ys.append(intermedia_output)
                if gpttr.diag_mask & SAVE_DT_CNT_LIST :
                    dt_cnt_list = " ".join(map(str, dt_cnt))
                    saved_dtlists.append(dt_cnt_list)

                del batch,x,opts

            except Exception as efor:
                pylogger.error(f"### ... ERROR in score() on {device_name}, trunkid={str(trunkid)} at step {step}")
                pylogger.exception(efor)
                traceback.print_exc()
                raise

        ### commented out because throws an error TODO
        #utilization_pct = torch.cuda.utilization(device_name)
        #pylogger.info(f'### ......  {device_name}: NVIDIA SMI reports GPU Utilizattion = {utilization_pct}')

        ys = torch.cat(ys).cpu().numpy()
        ys = pd.DataFrame(ys,columns = ['emb'+str(i) for i in range(gpttr.embedding_size)])
        ys[gpttr.entity_id] = data[gpttr.entity_id]
        ys = ys.head(dsize)


        # append to table
        #data = dataLoader(trunkid)
        load_job = bq_client.load_table_from_dataframe(
            dataframe = ys,
            destination = output_tbl,
            job_config = load_config,
        )

        if gpttr.diag_mask & SAVE_DT_CNT_LIST :
            saved_dt_pd = pd.DataFrame(saved_dtlists)
            output_tbl2 = output_tbl.replace('_embed_scored_tmp', '_saved_dt_cnt_lists_tmp')
            load_job2 = bq_client.load_table_from_dataframe(
                dataframe = saved_dt_pd,
                destination = output_tbl2,
                job_config = load_config,
            )
            pylogger.info(f'### ......  {device_name}: trunk# {trunkid+1} trace of dt_cnt lists appended to {output_tbl2}, result: {load_job2.result()}')


        pylogger.info(f'### ......  {device_name}: trunk# {trunkid+1} scored and appended to {output_tbl}, result: {load_job.result()}; [ys.shape: {format(ys.shape)}, dsize: {str(dsize)}]')

        #step = f'### ... score(), filename={filename} dumping results to blob via joblib'
        # ys = torch.cat(ys).cpu().numpy()
        # ys = pd.DataFrame(ys,columns = ['emb'+str(i) for i in range(_PTTR_STATE.embedding_size)])
        # ys[_PTTR_STATE.entity_id] = data[_PTTR_STATE.entity_id]
        # ys = ys.head(dsize)
        # gs_utils.joblib_data_dumper(ys, trunkid, bucket_name, envname, tenant, resource_sa)
        #blob = storage.Client(credentials=google.auth.default()[0]).bucket(bucket_name).blob(filename)
        #with blob.open("wb", ignore_flush=True) as f:
        #    joblib.dump(ys, f)
        result = 'SUCCESS'
        del ys
        #
    except Exception as e:
        pylogger.error(f"### ...... ERROR in score() on {device_name} scoring trunk {trunkid} at step {step}")
        pylogger.exception(e)
        traceback.print_exc()
        raise

    return result


#def score_file(input_tbl, output_tbl, data_path, model, bucket_name, envname, tenant, load_config, resource_sa, device):
def score_file(input_tbl, output_tbl, model, resource_sa):
    gpttr = model.PTTR_STATE
    ts = currentTime()
    pylogger.info(f'##### TIMESTAMP before reading data from BQ:: {ts}')
    #print('##### TIMESTAMP before reading data from BQ:', currentTime())

    #data = dataLoader(filename)
    bq_client = bq_utils.get_bigquery_client(resource_sa)
    job_labels = {"costcenter": 13070, "owner": "zhongc_aetna_com"}
    load_config = bigquery.LoadJobConfig(labels=job_labels)
    bq_client.delete_table(output_tbl, not_found_ok=True)

    if gpttr.diag_mask & SAVE_DT_CNT_LIST :
        output_tbl2 = output_tbl.replace('_embed_scored_tmp', '_saved_dt_cnt_lists_tmp')
        bq_client.delete_table(output_tbl2, not_found_ok=True)

    sql = """
        select *
        from """ + input_tbl + """
    """
    data = bq_client.query(sql).to_dataframe()
    data['dt_cnt'] = data['dt_cnt'] - 1

    ts = currentTime()
    pylogger.info(f'##### TIMESTAMP  after after reading data from BQ: {ts}')
    pylogger.info(f'##### TIMESTAMP all: {format(data.shape)} after reading data from BQ: {currentTime()}')

    trunksize = gpttr.batch_size*_PTTR_STATE.len_cd

    ntrunks = int(np.ceil(data.shape[0]/trunksize))
    lasttrunksize = gpttr.batch_size * (data.shape[0] % trunksize)
    device_name = 'cuda:0'
    num_successes = 0

    for trunk_id in range(ntrunks):
        #trunkdata = data.iloc[trunk_id*trunksize:(trunk_id+1)*trunksize,]
        if (trunk_id < ntrunks - 1):
            trunkdata = data.iloc[trunk_id*trunksize:(trunk_id+1)*trunksize,]
        else:
            trunkdata = data.iloc[trunk_id*trunksize:(trunk_id*trunksize+lasttrunksize),]
        #trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')

        pylogger.info(f'### ... Scoring trunk {str(trunk_id+1)} of {str(ntrunks)} on GPU {device_name} *** current time: {currentTime()}')
        #result = score(trunkdata,trunkid,model,bucket_name, envname, tenant, resource_sa, device)
        result = score(trunkdata, trunk_id, ntrunks, model, output_tbl, bq_client, load_config, device_name)
        if result == 'SUCCESS':
            num_successes += 1
        if False and trunk_id % _PTTR_STATE.len_cd == 71:
            torch.cuda.empty_cache()
            gc.collect()

    ts = currentTime()
    msg = f'##### TIMESTAMP  after score: {ts} after successfully scoring {str(num_successes)} trunks.'
    pylogger.info(msg)

    # data2 = []
    # for trunk_id in range(ntrunks):
    #     trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')
    #     data2.append(gs_utils.joblib_data_loader(trunkid, bucket_name, envname, tenant, resource_sa))
    #     pylogger.info(f'saving trunk_id: {str(trunk_id)} of {str(ntrunks)}')
    #
    # data2 = pd.concat(data2, ignore_index=True)
    #
    # ts = currentTime()
    # pylogger.info(f'##### TIMESTAMP  after embedding of size: {format(data2.shape)} is: {ts}')

    sql = """
        select count(1) as cnt
        from """ + output_tbl

    cnt = bq_client.query(sql).to_dataframe()['cnt'].tolist()

    pylogger.info(f'###### END OF TRUNK scoring; There are {" ".join(map(str, cnt))} rows in output table name: {output_tbl}')
    #for trunk_id in range(ntrunks):
    #    trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')
    #    blob = storage.Client(credentials=google.auth.default()[0]).bucket(bucket_name).blob(trunkid)
    #    blob.delete()

def parallel_score_file(filename, input_tbl, output_tbl_prefix, gpptr, model_bucket, envname, tenant, resource_sa, mpp_gpus, gpu_id):
    bestModel = gs_utils.joblib_data_loader(None, filename, model_bucket, envname, tenant, resource_sa)
    output_tbl = f'{output_tbl_prefix}_cuda_{str(gpu_id)}_embed_scored_tmp'

    device_name = f'cuda:{gpu_id}'
    device = torch.device(device_name)
    model = TransformerModel(device, gpptr.nhead, gpptr.nhid, gpptr.nlayers, 0)
    model.load_state_dict(bestModel['model'])
    model = model.to(device)

    ts = currentTime()
    pylogger.info(f'##### WORKER {gpu_id}: TIMESTAMP before reading data from BQ:: {ts}')
    pylogger.info(f'len_dy:{_PTTR_STATE.len_dy},len_cd:{_PTTR_STATE.len_cd}')
    #print('##### TIMESTAMP before reading data from BQ:', currentTime())

    try:

        #data = dataLoader(filename)
        bq_client = bq_utils.get_bigquery_client(resource_sa)
        job_labels = {"costcenter": 13070, "owner": "zhongc_aetna_com"}
        load_config = bigquery.LoadJobConfig(labels=job_labels)
        bq_client.delete_table(output_tbl, not_found_ok=True)
        if gpptr.diag_mask & SAVE_DT_CNT_LIST :
            output_tbl2 = output_tbl.replace('_embed_scored_tmp', '_saved_dt_cnt_lists_tmp')
            bq_client.delete_table(output_tbl2, not_found_ok=True)

        sql = f"select * except (dt_cnt ), (dt_cnt -1) as dt_cnt from {input_tbl} where mod(individual_id, {str(mpp_gpus)}) = {str(gpu_id)}"
        pylogger.info(f'running {sql}')
        data = bq_client.query(sql).to_dataframe()
        nlength=data.shape[0]
        pylogger.info(f'###### read {nlength} rows data from {input_tbl} for GPU:{gpu_id}')
        #data['dt_cnt'] = data['dt_cnt'] - 1

        ############### EXPERIMENT ####################
        # data = data.to(device)
        ###############################################

        ts = currentTime()
        pylogger.info(f'############# WORKER {gpu_id}: TIMESTAMP  after reading data from BQ: {ts}')


        trunksize = gpptr.batch_size * 96

        ntrunks = int(np.ceil(data.shape[0]/trunksize))
        lasttrunksize = gpptr.batch_size * (data.shape[0] % trunksize)
        #ndevices = torch.cuda.device_count()
        num_successes = 0

        for trunk_id in range(ntrunks):
            pylogger.info(f'### ... WORKER {gpu_id}: Scoring trunk {str(trunk_id+1)} of {str(ntrunks)} on the {device_name} GPU *** current time: {currentTime()}')
            if (trunk_id < ntrunks - 1):
                trunkdata = data.iloc[trunk_id*trunksize:(trunk_id+1)*trunksize,]
            else:
                trunkdata = data.iloc[trunk_id*trunksize:(trunk_id*trunksize+lasttrunksize),]
            #trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')

            #result = score(trunkdata,trunkid,model,bucket_name, envname, tenant, resource_sa, device)
            result = score(trunkdata, trunk_id, ntrunks, model, output_tbl, bq_client, load_config, device_name)
            if result == 'SUCCESS':
                num_successes += 1
            if False and (trunk_id % 96 == 73):
                torch.cuda.empty_cache()
                gc.collect()

    except Exception as e:
        pylogger.error(f'### EXCEPTION IN WORKER {gpu_id} scoring trunk {str(trunk_id+1)} of {str(ntrunks)} on the {device_name} GPU *** current time: {currentTime()}',
                       BaseException = e)
        raise


    ts = currentTime()
    msg = f'############# WORKER {gpu_id}: TIMESTAMP: {ts} AFTER scoring {str(num_successes)} trunks on the {device_name} GPU.'
    pylogger.info(msg)

    stats_dict = torch.cuda.memory_stats(device_name)
    pylogger.info(f'\n####################################################\n' \
                + f'###### GPU MEMORY STATISTICS FOR WORKER {gpu_id}: \n{json.dumps(stats_dict, indent=4)}\n' \
                + f'\n####################################################\n')

    # data2 = []
    # for trunk_id in range(ntrunks):
    #     trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')
    #     data2.append(gs_utils.joblib_data_loader(trunkid, bucket_name, envname, tenant, resource_sa))
    #     pylogger.info(f'saving trunk_id: {str(trunk_id)} of {str(ntrunks)}')
    #
    # data2 = pd.concat(data2, ignore_index=True)
    #
    # ts = currentTime()
    # pylogger.info(f'##### TIMESTAMP  after embedding of size: {format(data2.shape)} is: {ts}')

    sql = """
        select count(1) as cnt
        from """ + output_tbl

    cnt = bq_client.query(sql).to_dataframe()['cnt'].tolist()

    pylogger.info(f'###### WORKER {gpu_id}: END OF TRUNK scoring; There are {" ".join(map(str, cnt))} rows in output table name: {output_tbl}')
    #for trunk_id in range(ntrunks):
    #    trunkid = os.path.join(data_path,'trunk'+str(trunk_id)+'.p')
    #    blob = storage.Client(credentials=google.auth.default()[0]).bucket(bucket_name).blob(trunkid)
    #    blob.delete()


def combine_scored_files(output_tbl_prefix, output_tbl, resource_sa, ndevices):
    drop_table_stmt = f"DROP TABLE IF EXISTS {output_tbl}"
    bq_client = bq_utils.get_bigquery_client(resource_sa)
    job_labels = {"costcenter": 13070, "owner": "zhongc_aetna_com"}
    del_result = bq_utils.sql_exec(drop_table_stmt, resource_sa, bq_client)

    create_select_stmt = f'CREATE TABLE {output_tbl} AS SELECT * FROM {output_tbl_prefix}_cuda_0_embed_scored_tmp  '
    for i in range(ndevices-1):
        create_select_stmt += f'UNION ALL SELECT * FROM  {output_tbl_prefix}_cuda_{i+1}_embed_scored_tmp '

    cre_result = bq_utils.sql_exec(create_select_stmt, resource_sa, bq_client)

    return "SUCCESS"

def main():
    credentials, PROJECT_ID= google.auth.default()
    envname = f'{PROJECT_ID}'.split('-')[-1]

    isTest = False
    diag_mask = MASK0 # | SAVE_DT_CNT_LIST

    # TODO start measuring %%time
    str_today = currentDateTag()
    ts = currentTime()
    pylogger.info(f'##### TIMESTAMP program START: {ts}')
    #print('##### program START:', ts)

    model_bucket = "provider-ds-data-hcb-dev"
    model_path = 'a321276/TransformerV10/Model'
    model_name = 'bestModel_singlegpu'
    entity_id = ['individual_id','index_dt']

    (resource_sa, bqdb, tabprefix, envtype, owner, costcenter, tenant, bucket_name,
        tst_model_path, tsts_model_name, data_path, clustertag, mppgpus, smpl_tbl, scores_dt) \
        = transformer_embeddings_args(istest=isTest)

    job_labels = {"costcenter": 13070, "owner": "zhongc_aetna_com"}
    load_config = bigquery.LoadJobConfig(labels=job_labels)

    # maybe further tuning the machine!!!!,
    #os.environ.["PYTORCH_CUDA_ALLOC_CONF"] = "backend:cudaMallocAsync"
    os.environ["PYTORCH_CUDA_ALLOC_CONF"]="garbage_collection_threshold:0.8,expandable_segments:True"

    batch_size = 64
    embedding_size = 256
    minimum_mth_training = 6   #filter out data points which short month length
    len_dy = 200 # how many days in th seq
    len_cd = 80 # within a day how many cds.
    nhead = 16 # heads of transformer - double transformer share same feature...
    nhid = 512 # number of hidden of transformer - double transformer share same feature...
    nlayers = 6 # number of layers of transformer - double transformer share same feature...
    ndropout = 0.1 # dropout rate of transformer - double transformer share same feature...
    cd_cnt = 98041 # numbr of codes used in embedding matrix
    target_cd_cnt = 2 # numbr of target codes
    criterion = nn.NLLLoss()
    parallel = True
    pttr_state_init(batch_size,embedding_size,minimum_mth_training,len_dy,len_cd,nhead,nhid,nlayers,ndropout,cd_cnt,target_cd_cnt,entity_id, diag_mask)
    gpptr = pttr_state()

    filename = f'{model_path}/{model_name}'
    bestModel = gs_utils.joblib_data_loader(None, filename, model_bucket, envname, tenant, resource_sa)

    input_table = f'anbc-hcb-dev.{smpl_tbl}'
    output_table_tmp = f'{bqdb}.{tabprefix}_{clustertag}_embed_scores{scores_dt}_tmp'
    output_table = f'{tabprefix}_{clustertag}_embed_scores{scores_dt}'
    qual_output_table = f'{bqdb}.{tabprefix}_{clustertag}_embed_scores{scores_dt}'
    output_view =f'{bqdb}.{tabprefix}_embed_scores{scores_dt}'

    ndevices = torch.cuda.device_count()
    device = torch.device("cuda:0")

    if str(ndevices) != mppgpus :
        err_msg = f'###### ATTENTION!!! WARNING!!! CUDA reports {str(ndevices)} GPUs, but mmpgpus argument is {mppgpus}'
        if envtype == 'dev':
            pylogger.error(err_msg)
            raise ValueError(err_msg)
        else:
            pylogger.warning(err_msg)

    if ndevices > 1 :

        output_tbl_prefix = f'{bqdb}.{tabprefix}_{clustertag}'
        fargs = [filename, input_table, output_tbl_prefix, gpptr, model_bucket, envname, tenant, resource_sa, ndevices]

        processes = []
        index = 0
        for idx in range(ndevices):
            p = multiprocessing.Process(target=parallel_score_file, \
                                    args = fargs + [idx])
            p.start()
            processes.append(p)
            #index = index + 1

        for p in processes:
            p.join()

        combine_scored_files(output_tbl_prefix, output_table_tmp, resource_sa, ndevices)

    else:

        bestModel = gs_utils.joblib_data_loader(None, filename, model_bucket, envname, tenant, resource_sa)
        model = TransformerModel(device, nhead, nhid, nlayers, 0)
        model.load_state_dict(bestModel['model'])
        model = model.to(device)
        model = model.to(model.device)

        score_file(input_table, output_table_tmp, model, resource_sa)

    #data_path = 'a538383/TransformerV10/Data10pcnt'
    #ipt_name = 'a321276_o3_score_ending0.p'
    bq_client = bq_utils.get_bigquery_client(resource_sa)

    add_labels_stmt = f'ALTER TABLE {output_table_tmp} ' \
                      + f'SET OPTIONS ( labels=[("owner", "{owner}"),("costcenter", "{costcenter}")])'
    labels_result = bq_utils.sql_exec(add_labels_stmt, resource_sa, bq_client)
    drop_stmt = f'DROP TABLE IF EXISTS {qual_output_table}'
    del_result = bq_utils.sql_exec(drop_stmt, resource_sa, bq_client)
    rename_stmt = f'ALTER TABLE {output_table_tmp} RENAME TO {output_table}'
    rename_result = bq_utils.sql_exec(rename_stmt, resource_sa, bq_client)
    view_stmt = f'CREATE OR REPLACE VIEW {output_view} ' \
        + f'OPTIONS ( labels=[("owner", "{owner}"),("costcenter", "{costcenter}")]) ' \
        + f'AS SELECT * FROM {qual_output_table} '
    view_result = bq_utils.sql_exec(view_stmt, resource_sa, bq_client)

    ts = currentTime()
    pylogger.info(f'##### TIMESTAMP program END: {ts}')
    #print('##### program END:', ts)



if __name__ == '__main__':

    pylogger.info(f'##### SCORING CP IP TRANSFORMER MODEL USING PYTORCH, START TIMESTAMP: {currentTime()}')

    try:
        main()
        pylogger.info(f'##### SUCCESSFULLY SCORED, END TIMESTAMP: {currentTime()}')

    except Exception as e:
        pylogger.error(f'### EXCEPTION OCCURRED WHEN SCORING {currentTime()}')
        traceback.print_exc()
        raise

