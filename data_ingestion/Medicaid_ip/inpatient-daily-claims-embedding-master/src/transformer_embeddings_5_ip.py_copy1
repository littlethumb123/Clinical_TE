def transformer_embeddings_args(istest):
    # Instantiate our parser – and supply a description for the help mode
    parser = argparse.ArgumentParser(description="Python Argparse  for accp_features_ffe")
    parser.add_argument('--resource_sa=', required=True, type=str, action='store', dest='resource_sa', help="Specify resource service account --resource_sa=<resource_sa> ")
    parser.add_argument('--bqdb=', required=True, type=str, action='store', dest='bqdb', help="Specify BQ schema argument, e.g.,  --bqdb=clin_analytics_hcb_dev ")
    parser.add_argument('--tabprefix=', required=True, type=str, action='store', dest='tabprefix', help="Specify tabprefix argument for features, e.g., --tabprefix=cp_ip_pttr .")
    parser.add_argument('--envtype=', required=True, type=str, action='store', dest='envtype', help="Specify environment type - one of dev | test | prod ")
    parser.add_argument('--owner=', required=True, type=str, action='store', dest='owner', help="Specify 'owner' argument, e.g., --owner=zhongc_aetna_com ")
    parser.add_argument('--costcenter=', required=True, type=str, action='store', dest='costcenter', help="Specify costcenter argument, e.g., --costcenter=13070 .")
    parser.add_argument('--tenant=', required=True, type=str, action='store', dest='tenant', help="Specify tenant argument, e.g.,  --tenant=clin-analytics-hcb ")
    parser.add_argument('--tgt_bucket_name=', required=True, type=str, action='store', dest='tgt_bucket_name', help="Specify model storage bucket argument, e.g.,  --tgt_bucket_name=clin-analytics-data-hcb-dev ")
    parser.add_argument('--tgt_model_path=', required=True, type=str, action='store', dest='tgt_model_path', help="Specify model filepath argument, e.g.,  --tgt_model_path=<path> ")
    parser.add_argument('--tgt_model_name=', required=True, type=str, action='store', dest='tgt_model_name', help="Specify model filename argument, e.g.,  --tgt_model_name=bestModel ")
    parser.add_argument('--tgt_data_path=', required=True, type=str, action='store', dest='tgt_data_path', help="Specify data filepath argument, e.g.,  --tgt_data_path=<path> ")
    parser.add_argument('--clustertag=', required=True, type=str, action='store', dest='clustertag', help="Specify data cluster tag argument, e.g., one of g2l4 | a2a100 | vertexai ")
    parser.add_argument('--mppgpus=', required=True, type=str, action='store', dest='mppgpus', help="Specify number og NVIDIA GPUs in a cluster node, e.g. 1, 2, or 8 ")
    parser.add_argument('--smpl_tbl=', required=True, type=str, action='store', dest='smpl_tbl', help="Specify Transformer base argument (data input to transformer), e.g., --smpl_tbl=clin_analytics_hcb_dev.daily_claims_transformer_input .")
    parser.add_argument('--scores_dt=', required=True, type=str, action='store', dest='scores_dt', help="Specify scores_dt suffix of the transformer input table, e.g., --scores_dt=_20220316 .")

    argset = parser.parse_args()
    argset.smpl_tbl='clin_analytics_hcb_dev.me_rap_daily_clm_transformer_o3_score_ending_tmp'
    argset.scores_dt=''
    argset.tabprefix='me_rap_daily_clm_transformer'
    return argset.resource_sa, argset.bqdb, argset.tabprefix, argset.envtype, argset.owner, argset.costcenter, argset.tenant, \
        argset.tgt_bucket_name, argset.tgt_model_path, argset.tgt_model_name, argset.tgt_data_path, \
        argset.clustertag, argset.mppgpus, argset.smpl_tbl, argset.scores_dt

