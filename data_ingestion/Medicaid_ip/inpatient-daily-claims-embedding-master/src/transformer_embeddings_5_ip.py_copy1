def pttr_state_init(
        batch_size,
        embedding_size,
        minimum_mth_training,   #filter out data points which short month length
        len_dy, # how many days in th seq
        len_cd, # within a day how many cds.
        nhead, # heads of transformer - double transformer share same feature...
        nhid, # number of hidden of transformer - double transformer share same feature...
        nlayers, # number of layers of transformer - double transformer share same feature...
        ndropout, # dropout rate of transformer - double transformer share same feature...
        cd_cnt, # numbr of codes used in embedding matrix
        target_cd_cnt, # numbr of target codes
        entity_id, # "individual_id"
        diag_mask # diagnostic MASK
):
    PTTR_STATE = pttr_state_singleton()
    PTTR_STATE.batch_size = batch_size
    PTTR_STATE.embedding_size = embedding_size
    PTTR_STATE.minimum_mth_training = minimum_mth_training
    PTTR_STATE.len_dy = len_dy
    PTTR_STATE.len_cd = len_cd
    PTTR_STATE.nhead = nhead
    PTTR_STATE.nhid = nhid
    PTTR_STATE.nlayers = nlayers
    PTTR_STATE.ndropout = ndropout
    PTTR_STATE.cd_cnt = cd_cnt
    PTTR_STATE.target_cd_cnt = target_cd_cnt
    PTTR_STATE.entity_id = entity_id
    PTTR_STATE.diag_mask = diag_mask


_PTTR_STATE = pttr_state()
